{
  "id": "/",
  "name": "RydeSync",
  "short_name": "RydeSync",
  "description": "Live crew rooms with map, push-to-talk, and shared EchoVerse music.",
  "start_url": "/#dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#071014",
