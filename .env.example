# Runtime
NODE_ENV=development
PORT=9000
PUBLIC_BASE_URL=http://localhost:9000

# Room/session signing. REQUIRED in production and should remain stable across deploys.
ROOM_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ROOM_TTL_SECONDS=21600
MEMBER_TOKEN_TTL_SECONDS=28800

# AeroVista Identity / Access Convergence
# off      = guest-only product; protected member actions unavailable
# optional = recommended rollout mode: guest surfaces survive Identity outage; protected actions fail closed
# required = Identity verification failure returns service unavailable
AV_IDENTITY_MODE=optional
AV_IDENTITY_APP_ID=rydesync
AV_IDENTITY_TIMEOUT_MS=2500

# AeroCore App Adapter v0.1 / browser handoff.
# Account proves authentication; Identity Gateway brokers the trusted relying-app exchange.
# The platform parameter names are fixed: client_id, return_to, state and code.
AV_ACCOUNT_LOGIN_URL=https://account.aerocoreos.com/login
AV_IDENTITY_GATEWAY_ORIGIN=https://identity-api.aerovista.us
# REQUIRED for member login in production. Dedicated RydeSync HMAC secret; never commit the real value.
AV_IDENTITY_SERVICE_SECRET=
# Capabilities RydeSync refreshes live from Identity for its local principal snapshot.
AV_IDENTITY_CAPABILITIES=echoverse.library.listen
AV_BROWSER_SESSION_TTL_SECONDS=900

# Optional legacy bearer verifier for non-browser clients. Browser Account handoff does not use these.
AV_IDENTITY_BASE_URL=
AV_IDENTITY_VERIFY_PATH=

# Realtime room plane
REALTIME_AUTH_TIMEOUT_MS=10000
REALTIME_HEARTBEAT_MS=25000
REALTIME_MAX_MESSAGE_BYTES=32768

# Push-to-talk WebRTC. Signaling/control stays in the authenticated room WebSocket;
# microphone audio travels over WebRTC. TURN is required for reliable cellular/NAT traversal.
VOICE_ENABLED=true
VOICE_MAX_PEERS=12
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Ride-scoped live location. Coordinates are memory-only and not written to durable history.
LOCATION_MIN_INTERVAL_MS=5000
LOCATION_STALE_AFTER_MS=120000
LOCATION_MAX_CLIENT_AGE_MS=30000
LOCATION_MAX_FUTURE_SKEW_MS=10000
LOCATION_MAX_ACCURACY_METERS=5000

# Crew map. Development/light-testing default; production should use an approved provider.
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
MAP_MIN_ZOOM=2
MAP_MAX_ZOOM=18

# Shared soundtrack clock + drift policy. Realtime carries state, not audio bytes.
# Fast sync cadence keeps phones close without touching the audio transport itself.
PLAYBACK_SYNC_INTERVAL_MS=3000
PLAYBACK_SOFT_DRIFT_MS=150
PLAYBACK_HARD_DRIFT_MS=750

# Private canonical EchoVerse Library API. Never expose this upstream URL to clients.
ECHOVERSE_LIBRARY_API_URL=http://echoverse-library-api:5304
ECHOVERSE_TIMEOUT_MS=5000
# Optional server-only service bearer if the private Library API requires one.
ECHOVERSE_UPSTREAM_BEARER_TOKEN=

# Short-lived HttpOnly media grant. Full members receive library media scope after live
# entitlement; legitimate guest room members can receive current-shared-track-only scope.
ECHOVERSE_MEDIA_SESSION_TTL_SECONDS=600
